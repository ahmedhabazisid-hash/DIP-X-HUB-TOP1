-- DIPX UI patch
-- Loads the original script, then applies the requested UI changes.

local SOURCE = 'https://raw.githubusercontent.com/ahmedhabazisid-hash/DIP-X-HUB-TOP1/refs/heads/main/top1ahmed'

local ok, err = pcall(function()
    loadstring(game:HttpGet(SOURCE))()
end)

if not ok then
    warn("DIPX: original script failed: " .. tostring(err))
    return
end

task.spawn(function()
    local Players = game:GetService("Players")
    local CoreGui = game:GetService("CoreGui")
    local GuiService = game:GetService("GuiService")
    local LocalPlayer = Players.LocalPlayer

    local gui
    for i = 1, 100 do
        gui = CoreGui:FindFirstChild("SabcomUI")
        if gui then break end
        task.wait(0.1)
    end

    if not gui then
        warn("DIPX: SabcomUI not found")
        return
    end

    -- اللون الأزرق + شفافية الواجهة
    local BLUE = Color3.fromRGB(35, 125, 255)

    for _, obj in ipairs(gui:GetDescendants()) do
        if obj:IsA("Frame") or obj:IsA("TextButton") or obj:IsA("ImageButton")
            or obj:IsA("ScrollingFrame") or obj:IsA("TextBox") then

            if obj.BackgroundTransparency < 1 then
                obj.BackgroundTransparency = math.max(obj.BackgroundTransparency, 0.25)
            end

            pcall(function()
                obj.BackgroundColor3 = BLUE
            end)
        elseif obj:IsA("UIStroke") then
            obj.Color = BLUE
        elseif obj:IsA("TextLabel") or obj:IsA("TextButton") or obj:IsA("TextBox") then
            obj.TextColor3 = Color3.fromRGB(235, 245, 255)
        end
    end

    -- الاسم DIPX
    for _, obj in ipairs(gui:GetDescendants()) do
        if obj:IsA("TextLabel") or obj:IsA("TextButton") then
            local t = tostring(obj.Text):lower()
            if t == "sabcom hub" or t == "sabcom" then
                obj.Text = "DIPX"
            end
        end
    end

    -- زر Kick: يخليك أنت تخرج من اللعبة عند الضغط
    _G.SabcomDoKick = function()
        LocalPlayer:Kick("DIPX Kick")
    end

    for _, obj in ipairs(gui:GetDescendants()) do
        if obj:IsA("TextButton") and tostring(obj.Text):lower() == "kick" then
            obj.MouseButton1Click:Connect(function()
                LocalPlayer:Kick("DIPX Kick")
            end)
        end
    end

    -- زر ROBLOX: يفتح صفحة Roblox في المتصفح
    local robloxButton
    for _, obj in ipairs(gui:GetDescendants()) do
        if obj:IsA("TextButton") and tostring(obj.Text):lower() == "roblox" then
            robloxButton = obj
            break
        end
    end

    if robloxButton then
        robloxButton.MouseButton1Click:Connect(function()
            pcall(function()
                GuiService:OpenBrowserWindow("https://www.roblox.com/")
            end)
        end)
    end
end)
